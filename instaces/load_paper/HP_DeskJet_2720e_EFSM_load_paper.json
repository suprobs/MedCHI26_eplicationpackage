    {
      "id": "r_paper_orientation",
      "name": "Paper orientation",
      "description": "Insert the paper with the short edge down and the print side up.",
      "expr": null,
      "priority": 1,
      "applies_to": [
        "t_machine_paper_1"
      ]
    },
    {
      "id": "r_same_size_type",
      "name": "Uniform stack",
      "description": "All paper in the stack must be the same size and type, flat, with edges not bent or torn, to avoid paper jams.",
      "expr": null,
      "priority": 1,
      "applies_to": [
        "t_machine_paper_1"
      ]
    },
    {
      "id": "r_no_overfill",
      "name": "Do not overfill",
      "description": "Do not overfill the input tray (up to 60 plain sheets) and do not force paper too far down.",
      "expr": null,
      "priority": 1,
      "applies_to": [
        "t_machine_paper_1"
      ]
    },
    {
      "id": "r_guide_no_bend",
      "name": "Guide must not bend paper",
      "description": "The paper-width guide must fit snugly against the paper without bending it.",
      "expr": "machine_paper_width_guide.position eq snug",
      "priority": 1,
      "applies_to": [
        "t_machine_paper_width_guide_2"
      ]
    },
    {
      "id": "r_no_add_while_printing",
      "name": "No loading while printing",
      "description": "Do not add paper while the printer is printing; wait for the out of paper message.",
      "expr": null,
      "priority": 2,
      "applies_to": [
        "load_paper"
      ]
    }
  ]
